<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Strait SDK privacy manifest.
  - No tracking, no tracking domains, no advertising identifiers.
  - Collected (never linked to identity, never used for tracking, never shared,
    used only to open the right screen in this same app):
    * Coarse location: the server sees the request IP. It keeps only a keyed hash
      (HMAC) of the IP address and of its IPv6 /64, plus the /24 (IPv4) or /48
      (IPv6) network prefix, for the 1-hour match of a tap to the first app open
      (deferred deep links); they are erased a day later. Each workspace chooses
      whether to use iPhone device matching (off for new workspaces).
    * Other data: screen size, preferred language, time zone and iOS version, sent
      once on first launch for the same short-lived match.
    * Product interaction: link opens reported to the app owner's Strait workspace,
      each with the app's version (CFBundleShortVersionString) and this SDK's version,
      for support. Reading the app's own Info.plist is not a required-reason API.
      Plus at most three "came back" notes per install, ever (day 1, 7 and 30 after
      the install), each with only the install's tap id (Strait's own random id for
      the tap that brought the install), the day, the platform and the versions.
  - User ID (only when the app calls setUserId): the app's own id for its signed-in
    user goes with later events to the app owner's Strait workspace, so they can join
    events to their users (linked to the user, never used for tracking). Ids that look
    like an email or phone number are hashed (SHA-256) on the device and never sent raw.
  - Paste handoff (off by default): only when the app owner turns it on in
    their Strait dashboard (read from Strait's server on first launch), the SDK
    checks the clipboard on first launch and sends only a Strait handoff token
    found there, never other clipboard text.
  - Required-reason API: UserDefaults stores the SDK's own state (CA92.1): the
    once-per-install flag, the last tap id, the install's tap id (for the
    "came back" notes; deleted by setEnabled(false)), and open reports waiting to be
    re-sent (at most 7 days / 100).
  - Required-reason API: file timestamps (C617.1): the creation date of the SDK's
    own empty marker file Application Support/Strait/install-time, inside the app
    container, tells a reinstall or a restored phone from an app update (B6a).
    It never leaves the device.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
